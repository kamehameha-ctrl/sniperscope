# Shodan API Key (obtén tu key en https://account.shodan.io)
SHODAN_API_KEY=tu_api_key_de_shodan_aqui

# Proxy de Salida para anonimización (Cloudflare WARP en modo Proxy local o SOCKS5/HTTP)
# Ejemplo con WARP CLI: warp-cli mode proxy && warp-cli proxy port 40000 && warp-cli connect
OUTBOUND_PROXY=http://127.0.0.1:40000

# Credenciales de Operador para acceso al panel SniperScope
SNIPERSCOPE_USER=sniperadmin
SNIPERSCOPE_PASS=tu_contraseña_robusta_aqui
